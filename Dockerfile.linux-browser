FROM mcr.microsoft.com/playwright:v1.62.0-noble

ARG TONGMU_BUILD_SHA=development
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3333 \
    RTMP_PORT=3334 \
    HTTP_FLV_PORT=3335 \
    PROJECT_ROOT=/app \
    CONFIG_DIR=/app/config \
    MEDIA_BROWSER_RESOLVER=true \
    MEDIA_BROWSER_MAX_CONCURRENCY=1 \
    TONGMU_BUILD_SHA=${TONGMU_BUILD_SHA}

WORKDIR /app

# The browser image is intentionally separate from the lightweight packaged
# runtime. The exact Playwright image tag matches backend/package.json and
# already contains Chromium plus its Linux libraries.
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY patches ./patches
COPY frontend/vendor ./frontend/vendor
RUN npm ci --include=dev

COPY backend ./backend
COPY frontend ./frontend
RUN npm run build --workspace=backend \
    && npm run build --workspace=frontend \
    && npm prune --omit=dev \
    && mkdir -p config/ssl config/uploads config/media log

EXPOSE 3333 3334

CMD ["node", "backend/dist/index.js"]
