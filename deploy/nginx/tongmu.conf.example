# TongMu 新 VPS HTTP 反向代理模板。
# 初次使用将 __TONGMU_DOMAIN__ 替换为正式域名，再 certbot --nginx -d <域名> --redirect。
# 此文件由 /etc/nginx/nginx.conf 的 http {} 内通过 sites-enabled 引入。

map $http_upgrade $tongmu_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __TONGMU_DOMAIN__;

    client_max_body_size 100m;

    location / {
        proxy_pass http://127.0.0.1:3333;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tongmu_connection_upgrade;

        proxy_connect_timeout 20s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Socket.IO、SSE、HTTP-FLV 和实时媒体不被 Nginx 缓冲。
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
